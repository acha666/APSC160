{
  "name": "c-cpp-lab (codespaces)",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-noble",

  "remoteUser": "vscode",

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y gdb clangd",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "llvm-vs-code-extensions.vscode-clangd",
        "vadimcn.vscode-lldb",
        "esbenp.prettier-vscode",
        "oderwat.indent-rainbow"
      ]
    }
  }
}
