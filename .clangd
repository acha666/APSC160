CompileFlags:
  # Ignore warning flags inherited from external compile commands, then use a
  # small, consistent warning set for this workspace.
  #
  # clangd does not remove flags added by the same CompileFlags entry.
  Remove:
    - "-W*"
  Add:
    - "-Wall"
    - "-Wextra"
    - "-Wpedantic"

Diagnostics:
  ClangTidy:
    Add:
      - readability-*
      - modernize-*
      - performance-*
    Remove:
      - modernize-use-trailing-return-type
  UnusedIncludes: Strict

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

Hover:
  ShowAKA: Yes
